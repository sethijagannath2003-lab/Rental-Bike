    <!-- Bootstrap JS Bundle with Popper -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <!-- jQuery -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <!-- WOW.js for animations -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/wow/1.1.2/wow.min.js"></script>
    <script>
        // In your existing JavaScript, update the checkout button functionality
        document.getElementById('checkoutBtn').addEventListener('click', function(e) {
            e.preventDefault();

            // Check if user is logged in
                            // Redirect to login with return URL
                window.location.href = 'login-signup.php?redirect=checkout';
                    });
    </script>
    <script>
        // Initialize WOW.js
        new WOW().init();

        // Add animation to profile image on hover
        $(document).ready(function() {
            $('.profile-icon').hover(
                function() {
                    $(this).addClass('animate__animated animate__pulse');
                },
                function() {
                    $(this).removeClass('animate__animated animate__pulse');
                }
            );

            // Smooth scroll for anchor links
            $('a[href^="#"]').on('click', function(event) {
                var target = $(this.getAttribute('href'));
                if (target.length) {
                    event.preventDefault();
                    $('html, body').stop().animate({
                        scrollTop: target.offset().top - 70
                    }, 1000);
                }
            });
        });
    </script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Initialize cart if not exists
            if (!localStorage.getItem('rent2riderCart')) {
                localStorage.setItem('rent2riderCart', JSON.stringify({
                    items: [],
                    subtotal: 0,
                    total: 0
                }));
            }

            updateCartDisplay();
            updateAddToCartButtons();



            // Clear All button
            const clearCartBtn = document.getElementById('clearCartBtn');
            if (clearCartBtn) {
                clearCartBtn.addEventListener('click', clearCart);
            }

            // SINGLE delegated click handler for all add-to-cart buttons
            document.addEventListener('click', function(e) {
    const btn = e.target.closest('.add-to-cart');
    if (!btn) return;

    e.preventDefault();
    e.stopPropagation();

    const id = String(btn.dataset.id);
    const name = btn.dataset.name;
    const price = parseFloat(btn.dataset.price || '0');
    const image = btn.dataset.image || '';
    const type = id.startsWith('acc_') ? 'accessory' : 'bike';
    const maxQuantity = parseInt(btn.dataset.maxQuantity || '0'); // Get max quantity

    const cart = JSON.parse(localStorage.getItem('rent2riderCart'));
    const isInCart = cart.items.some(item => String(item.id) === id);

    if (isInCart) {
        const cartSidebar = new bootstrap.Offcanvas(document.getElementById('cartSidebar'));
        cartSidebar.show();
        return;
    }

    addToCart(id, name, price, image, type, maxQuantity);
    const cartSidebar = new bootstrap.Offcanvas(document.getElementById('cartSidebar'));
    cartSidebar.show();
});



        });

        // --- Cart core ---
        function getCart() {
            return JSON.parse(localStorage.getItem('rent2riderCart')) || {
                items: [],
                subtotal: 0,
                total: 0
            };
        }

        function saveCart(cart) {
            localStorage.setItem('rent2riderCart', JSON.stringify(cart));
        }

        function addToCart(id, name, price, image, type = 'bike', maxQuantity = 0) {
    const cart = getCart();
    const existingItem = cart.items.find(it => String(it.id) === String(id));
    
    if (existingItem) {
        // Check if we can add more of this item
        if (maxQuantity > 0 && existingItem.quantity >= maxQuantity) {
            showToast(`Cannot add more. Maximum ${maxQuantity} available.`, {type: 'danger'});
            return;
        }
        existingItem.quantity += 1;
    } else {
        cart.items.push({
            id,
            name,
            price,
            image,
            quantity: 1,
            type: type,
            maxQuantity: maxQuantity // Store max quantity for validation
        });
    }
    calculateCartTotals(cart);
    saveCart(cart);
    updateCartDisplay();
    updateAddToCartButtons();
    showToast('Item added to cart!');
}



        function removeFromCart(id) {
            const cart = getCart();
            const idx = cart.items.findIndex(it => String(it.id) === String(id));
            if (idx !== -1) {
                cart.items.splice(idx, 1);
                calculateCartTotals(cart);
                saveCart(cart);
                updateCartDisplay();
                updateAddToCartButtons();
                showToast('Item removed from cart!');
            }
        }

function updateQuantity(id, change) {
    const cart = getCart();
    const idx = cart.items.findIndex(it => String(it.id) === String(id));
    
    if (idx !== -1) {
        const item = cart.items[idx];
        const newQuantity = item.quantity + change;
        
        // Check if new quantity exceeds max allowed
        if (item.maxQuantity > 0 && newQuantity > item.maxQuantity) {
            showToast(`Cannot exceed maximum quantity of ${item.maxQuantity}`, {type: 'danger'});
            return;
        }
        
        if (newQuantity <= 0) {
            cart.items.splice(idx, 1);
        } else {
            item.quantity = newQuantity;
        }
        
        calculateCartTotals(cart);
        saveCart(cart);
        updateCartDisplay();
        updateAddToCartButtons();
    }
}


        function calculateCartTotals(cart) {
            cart.subtotal = cart.items.reduce((t, it) => t + (Number(it.price) * Number(it.quantity)), 0);
            cart.total = cart.subtotal; // No tax calculation
        }

        function clearCart() {
            const cart = {
                items: [],
                subtotal: 0,
                total: 0
            };
            saveCart(cart);
            updateCartDisplay();
            updateAddToCartButtons();
            showToast('Cart cleared!');
        }

        function updateCartDisplay() {
    const cart = getCart();
    const cartItemsContainer = document.getElementById('cartItemsContainer');
    const cartSummary = document.getElementById('cartSummary');
    const cartCount = document.getElementById('cartCount');
    if (!cartItemsContainer || !cartCount) return;

    const totalItems = cart.items.reduce((t, i) => t + i.quantity, 0);
    cartCount.textContent = totalItems;

    cartItemsContainer.innerHTML = '';
    if (!cart.items.length) {
        cartItemsContainer.innerHTML = `
            <p class="text-muted text-center py-4" id="emptyCartMessage">
                <i class="bi bi-cart-x display-4 d-block mb-2"></i>
                Your cart is empty
            </p>`;
        if (cartSummary) cartSummary.classList.add('d-none');
        return;
    }

    if (cartSummary) cartSummary.classList.remove('d-none');

    cart.items.forEach(item => {
        const el = document.createElement('div');
        el.className = 'cart-item';

        const typeBadge = item.type === 'accessory' ?
            '<span class="badge bg-info ms-2">Accessory</span>' :
            '<span class="badge bg-primary-yellow ms-2">Vehicle</span>';

        // Add quantity limit indicator if applicable
        const quantityLimit = item.maxQuantity > 0 ? 
            `<small class="text-muted d-block">Max: ${item.maxQuantity}</small>` : '';

        el.innerHTML = `
            <div class="d-flex align-items-center">
                <img src="${item.image}" alt="${escapeHtml(item.name)}" class="img-fluid" style="width:70px;height:70px;object-fit:contain;border-radius:8px;border:1px solid #eee;">
                <div class="cart-item-details">
                    <div class="cart-item-title">${escapeHtml(item.name)} ${typeBadge}</div>
                    <div class="cart-item-price">₹${Number(item.price).toFixed(2)}/day</div>
                    ${quantityLimit}
                </div>
            </div>
            <div class="d-flex align-items-center gap-2">
                <div class="quantity-controls">
                    <button class="quantity-btn" onclick="updateQuantity('${item.id}', -1)">-</button>
                    <span class="quantity-display">${item.quantity}</span>
                    <button class="quantity-btn" onclick="updateQuantity('${item.id}', 1)">+</button>
                </div>
                <button class="remove-btn" onclick="removeFromCart('${item.id}')"><i class="bi bi-trash"></i></button>
            </div>`;
        cartItemsContainer.appendChild(el);
    });

    const fmt = v => `₹${Number(v).toFixed(2)}`;
    const totalEl = document.getElementById('cartTotal');
    if (totalEl) totalEl.textContent = fmt(cart.total);
}


        function updateAddToCartButtons() {
            const cart = getCart();
            document.querySelectorAll('.add-to-cart').forEach(btn => {
                btn.setAttribute('type', 'button');
                const id = String(btn.dataset.id);
                const isInCart = cart.items.some(it => String(it.id) === id);

                if (isInCart) {
                    btn.innerHTML = '<i class="bi bi-cart-check me-1"></i>Go to Cart';
                    btn.classList.remove('btn-outline-primary');
                    btn.classList.add('btn-success');
                    btn.removeAttribute('data-bs-toggle');
                    btn.removeAttribute('data-bs-target');
                } else {
                    btn.textContent = 'Add to Cart';
                    btn.classList.remove('btn-success');
                    btn.classList.add('btn-outline-primary');
                    btn.removeAttribute('data-bs-toggle');
                    btn.removeAttribute('data-bs-target');
                }
            });
        }

        function showToast(message, opts = {}) {
            const {
                title = 'Rent2Rider',
                    type = 'success',
                    autohide = true,
                    delay = 2500,
                    icon = null
            } = opts;

            let container = document.querySelector('.toast-container');
            if (!container) {
                container = document.createElement('div');
                container.className = 'toast-container position-fixed bottom-0 end-0 p-3';
                document.body.appendChild(container);
            }

            const id = 'r2r_toast_' + Date.now();
            const chosenIcon = icon || (type === 'danger' ? 'bi-x-circle' : type === 'info' ? 'bi-info-circle' : 'bi-bag-check');

            const html = `
        <div id="${id}" class="toast r2r-toast ${type}" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="toast-header">
                <span class="r2r-badge me-2"><i class="bi ${chosenIcon}"></i></span>
                <strong class="me-auto">${title}</strong>
                <small class="text-muted">just now</small>
                <button type="button" class="btn-close ms-2" data-bs-dismiss="toast" aria-label="Close"></button>
            </div>
            <div class="toast-body">${message}</div>
        </div>`;

            container.insertAdjacentHTML('beforeend', html);

            const el = document.getElementById(id);
            const toast = new bootstrap.Toast(el, {
                autohide,
                delay
            });
            toast.show();

            el.addEventListener('hidden.bs.toast', () => el.remove());
        }

        function escapeHtml(s) {
            return String(s).replace(/[&<>"']/g, m => ({
                '&': '&amp;',
                '<': '&lt;',
                '>': '&gt;',
                '"': '&quot;',
                "'": '&#039;'
            } [m]));
        }
    </script>

</body>

</html>
<!-- Simple 404 Page -->
<section class="container my-5">
