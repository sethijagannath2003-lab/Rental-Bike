</style>

<style>
    /* Custom Dropdown Styling */
    .dropdown-menu-custom {
        min-width: 220px;
        padding: 0.75rem 0;
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(0, 0, 0, 0.08);
        animation: dropdownFadeIn 0.3s ease;
    }

    @keyframes dropdownFadeIn {
        from {
            opacity: 0;
            transform: translateY(-10px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .dropdown-item-custom {
        padding: 0.75rem 1.25rem;
        transition: all 0.3s ease;
        border-radius: 0;
        display: flex;
        align-items: center;
        font-weight: 500;
        color: #495057;
    }

    .dropdown-item-custom:hover {
        background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
        color: #212529;
        transform: translateX(5px);
        padding-left: 1.5rem;
    }

    .dropdown-item-custom i {
        font-size: 14px;
        width: 20px;
        transition: all 0.3s ease;
    }

    .dropdown-item-custom:hover i {
        transform: scale(1.1);
    }

    .dropdown-divider {
        border-color: rgba(0, 0, 0, 0.08);
        opacity: 0.5;
    }

    /* Dropdown Toggle Enhancement */
    .nav-link.dropdown-toggle {
        font-weight: 500;
        transition: all 0.3s ease;
        border-radius: 6px;
        padding: 0.5rem 1rem;
    }

    .nav-link.dropdown-toggle:hover {
        background: rgba(0, 123, 255, 0.1);
        color: var(--bs-primary) !important;
    }

    .nav-link.dropdown-toggle::after {
        transition: transform 0.3s ease;
    }

    .nav-link.dropdown-toggle[aria-expanded="true"]::after {
        transform: rotate(180deg);
    }

    /* Mobile Responsive */
    @media (max-width: 991px) {
        .dropdown-menu-custom {
            position: static !important;
            transform: none !important;
            box-shadow: none;
            border: none;
            background: transparent;
            padding-left: 1rem;
        }
        
        .dropdown-item-custom {
            padding: 0.5rem 1rem;
            border-radius: 6px;
            margin: 0.25rem 0;
        }
        
        .dropdown-item-custom:hover {
            transform: none;
            padding-left: 1rem;
            background: rgba(0, 123, 255, 0.1);
        }
    }

    .navbar-nav .nav-link.active {
        background: rgba(13,110,253,0.1);
        border-radius: 6px;
        font-weight: 600;
        color: #0d6efd !important;
    }
</style>

<style>
    /* Minimal Yellow Book Now Button - Normal Case */
    .minimal-book-btn {
        background: #ffa318; /* Golden Yellow */
        color: #000000 !important; /* Force Black Text */
        font-weight: 700;
        font-size: 14px;
        padding: 2px 5x;
        border-radius: 25px;
        position: relative;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        /* text-transform: uppercase;  <- এটা remove করা হয়েছে */
        letter-spacing: 0.5px; /* Slight letter spacing for better readability */
        box-shadow: 0 2px 10px rgba(255, 215, 0, 0.3);
        transition: all 0.3s ease;
        min-width: 120px;
        text-decoration: none;
        overflow: hidden;
    }

    /* Ensure icon stays black */
    .minimal-book-btn .btn-icon {
        color: #000000 !important; /* Force Black Icon */
        transition: transform 0.3s ease;
        font-size: 14px;
    }

    .minimal-book-btn .btn-icon i {
        color: #000000 !important; /* Force Black Arrow */
    }

    .minimal-book-btn::before {
        content: '';
        position: absolute;
        top: 0;
        left: -100%;
        width: 100%;
        height: 100%;
        background: linear-gradient(90deg, transparent, rgba(0, 0, 0, 0.1), transparent);
        transition: left 0.5s;
        z-index: 1;
    }

    .minimal-book-btn:hover::before {
        left: 100%;
    }

    .minimal-book-btn:hover {
        background: #e69500; /* Darker Orange-Yellow on hover */
        color: #000000 !important;
        transform: translateY(-2px);
        box-shadow: 0 4px 15px rgba(255, 215, 0, 0.4);
    }

    .minimal-book-btn:hover .btn-icon,
    .minimal-book-btn:hover .btn-icon i {
        color: #000000 !important; /* Black icon on hover */
    }

    .minimal-book-btn .btn-text {
        font-weight: 700;
        transition: all 0.3s ease;
        color: #000000 !important; /* Force Black Text */
    }

    .minimal-book-btn:hover .btn-text {
        color: #000000 !important; /* Black text on hover */
    }

    .minimal-book-btn .btn-line {
        height: 2px;
        background: #000000; /* Black line */
        width: 30px;
        transition: width 0.3s ease;
        margin-left: auto;
    }

    .minimal-book-btn:hover .btn-line {
        width: 0;
    }

    /* Active State */
    .minimal-book-btn:active {
        transform: translateY(0);
        box-shadow: 0 2px 8px rgba(255, 215, 0, 0.3);
        color: #000000 !important;
    }

    .minimal-book-btn:active .btn-icon,
    .minimal-book-btn:active .btn-icon i {
        color: #000000 !important;
    }

    /* Focus State for Accessibility */
    .minimal-book-btn:focus {
        outline: none;
        box-shadow: 0 0 0 3px rgba(255, 215, 0, 0.5);
        color: #000000 !important;
    }

    /* Responsive Design */
    @media (max-width: 768px) {
        .minimal-book-btn {
            padding: 8px 16px;
            min-width: 100px;
            height: 38px;
            font-size: 13px;
            letter-spacing: 0.3px;
        }
        
        .minimal-book-btn .btn-text {
            display: none;
        }
        
        .minimal-book-btn {
            border-radius: 20px;
        }
        
        /* Ensure black icon on mobile */
        .minimal-book-btn .btn-icon,
        .minimal-book-btn .btn-icon i {
            color: #000000 !important;
        }
    }

    @media (max-width: 576px) {
        .minimal-book-btn {
            padding: 6px 12px;
            height: 34px;
            min-width: 80px;
        }
        
        .minimal-book-btn .btn-icon {
            font-size: 12px;
            color: #000000 !important;
        }
        
        .minimal-book-btn .btn-icon i {
            color: #000000 !important;
        }
    }

    /* Animation on Load */
    @keyframes slideInRight {
        from {
            opacity: 0;
            transform: translateX(20px);
        }
        to {
            opacity: 1;
            transform: translateX(0);
        }
    }

    .minimal-book-btn {
        animation: slideInRight 0.6s ease-out;
    }

    /* Hide Topbar on Small Screens */
    @media (max-width: 576px) {
        .topbar {
            display: none !important;
        }
    }
</style>

